(label "HEATER_LOW"  (at 208.2800 53.3400 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "853c287d-410f-52db-986e-17d96a633f0d"))
(hierarchical_label "GND" (shape input) (at 25.4000 127.0000 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "27cb0559-aa83-59f5-a38b-d7e6a1c70be6"))
(text "PWM HIGH / high impedance with 3V3 present: heater OFF. PWM LOW: heater ON.\nJx01 pin 1 = measured VIN; pin 2 = switched return. Do not bond pin 2 to ground.\nDefault-off depends on 3V3: loss of logic power can turn the heater ON.\nUse slow PWM; verify switching loss, current limit and thermal margins on the bench." (at 25.4000 147.3200 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3df911d0-2b2c-5220-abc3-6e4206c7cb62"))
